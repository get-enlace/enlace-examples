<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.get-enlace.examples</groupId>
    <artifactId>enlace-examples-java</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>enlace-examples-java</name>
    <description>Sample Spring Boot app exercising enlace-java's Spring Boot starter, implementing the shared example contract (../CONTRACT.md)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Serves the OpenAPI document this example's own API produces, at springdoc's
             default /v3/api-docs — the first path enlace-spring-boot-starter probes, so
             this example needs zero Enlace-specific config beyond the dependency itself. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- enlace-java has no publishing pipeline yet (see its CONTRIBUTING.md) — this
             resolves from your local ~/.m2, populated by running `mvn install` in
             ../../enlace-java first. See this directory's README for the full local
             workflow, including pulling in a real @get-enlace/ui bundle. -->
        <dependency>
            <groupId>io.github.get-enlace</groupId>
            <artifactId>enlace-spring-boot-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
