<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Latest dev builds of Enlace.AspNetCore, published automatically on every
         push to enlace-dotnet's main. Requires GITHUB_USERNAME/GITHUB_TOKEN below
         (GitHub Packages requires auth even for public reads). -->
    <add key="enlace-github" value="https://nuget.pkg.github.com/get-enlace/index.json" />
    <!-- Uncomment to test against a local (unpublished) enlace-dotnet build instead.
         Regenerate with: (cd ../../enlace-dotnet && dotnet pack src/Enlace.AspNetCore -c Release -o artifacts/nuget)
    <add key="enlace-local" value="../../enlace-dotnet/artifacts/nuget" />
    -->
  </packageSources>
  <packageSourceCredentials>
    <enlace-github>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </enlace-github>
  </packageSourceCredentials>
</configuration>
